'use client';

import React from 'react';
import Link from 'next/link';
import { Globe, Search, BookOpen, Send, ShieldCheck, Package, Smartphone, ArrowRight, CheckCircle } from 'lucide-react';
import { analyticsEvents } from '@/lib/analytics';

const paquetes = [
  { slug: 'starter', title: 'Starter', price: '$597', tagline: 'Todo lo necesario para lanzar tu empresa en EE.UU.', icon: Globe, destacado: false },
  { slug: 'professional', title: 'Professional', price: '$897', tagline: 'Formación completa + apoyo para abrir cuenta bancaria.', icon: Smartphone, destacado: true },
  { slug: 'business', title: 'Business', price: '$1397', tagline: 'Primer año casi todo resuelto. Gestión fiscal y soporte.', icon: Package, destacado: false },
];

const serviciosSueltos = [
  {
    slug: 'formacion-llc',
    title: 'Formación de LLC',
    price: '$497',
    tagline: 'Constitución completa de tu LLC en el estado que elijas.',
    icon: Globe,
    highlight: false,
  },
  {
    slug: 'obtencion-ein',
    title: 'Obtención de EIN',
    price: '$197',
    tagline: 'Número fiscal federal para tu empresa (IRS).',
    icon: Search,
    highlight: false,
  },
  {
    slug: 'impuestos/declaracion-anual-llc',
    title: 'Declaración de Impuestos',
    price: '$397',
    tagline: 'Presentación anual del Formulario 1120 + 5472.',
    icon: BookOpen,
    highlight: true,
  },
  {
    slug: 'consultoria-fiscal',
    title: 'Consultoría Fiscal',
    price: '$197',
    tagline: 'Sesiones personalizadas sobre estructura y fiscalidad.',
    icon: Send,
    highlight: false,
  },
  {
    slug: 'agente-registrado',
    title: 'Agente Registrado + Dirección Física',
    price: '$149/año',
    tagline: 'Cumple con todos los requisitos legales sin viajar.',
    icon: ShieldCheck,
    highlight: false,
  },
  {
    slug: 'reporte-anual',
    title: 'Reporte Anual Estatal',
    price: 'Desde $99',
    tagline: 'Mantenimiento obligatorio de tu LLC año tras año.',
    icon: Package,
    highlight: true,
  },
  {
    slug: 'launch-banking',
    title: 'Cuenta Bancaria Empresarial',
    price: '$199',
    tagline: 'Abre cuenta en dólares en EE.UU. sin viajar.',
    icon: Smartphone,
    highlight: false,
  },
];

export default function ServiciosPage() {
  return (
    <main className="max-w-7xl mx-auto px-6 py-16">
      {/* Hero Mejorado */}
      <div className="text-center mb-20">
        <h1 className="text-5xl md:text-6xl font-extrabold text-gray-900 mb-6">
          Servicios para tu LLC en Estados Unidos
        </h1>
        <p className="text-2xl text-gray-600 max-w-4xl mx-auto">
          Todo lo que necesitas para <span className="font-semibold text-blue-600">constituir, operar y mantener</span> tu empresa americana con total tranquilidad.
        </p>
      </div>

      {/* Paquetes */}
      <section className="mb-24">
        <div className="text-center mb-12">
          <h2 className="text-4xl font-bold text-gray-900">Paquetes Completos</h2>
          <p className="text-gray-600 mt-4">La forma más fácil y segura de empezar</p>
        </div>

        <div className="grid md:grid-cols-3 gap-8">
          {paquetes.map((paquete) => {
            const Icon = paquete.icon;
            return (
              <Link
                key={paquete.slug}
                href={`/paquetes/${paquete.slug}/onboarding`}
                className={`group relative bg-white border-2 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all ${paquete.destacado ? 'border-purple-500 scale-[1.02]' : 'border-gray-200 hover:border-blue-500'}`}
              >
                {paquete.destacado && <div className="absolute -top-4 right-6 bg-purple-600 text-white text-sm font-bold px-5 py-1 rounded-full">MÁS POPULAR</div>}
                
                <div className="flex justify-center mb-6">
                  <div className="w-20 h-20 bg-blue-50 rounded-2xl flex items-center justify-center">
                    <Icon className="text-blue-600" size={42} />
                  </div>
                </div>
                <h3 className="text-3xl font-bold text-center mb-2">{paquete.title}</h3>
                <p className="text-4xl font-extrabold text-center text-blue-600 mb-4">{paquete.price}</p>
                <p className="text-gray-600 text-center mb-8">{paquete.tagline}</p>
                
                <div className="text-blue-600 font-semibold flex items-center justify-center gap-2 group-hover:gap-3 transition-all">
                  Ver plan completo <ArrowRight />
                </div>
              </Link>
            );
          })}
        </div>
      </section>

      {/* Servicios Individuales - Mejorados */}
      <section>
        <div className="text-center mb-12">
          <h2 className="text-4xl font-bold text-gray-900">Servicios Individuales</h2>
          <p className="text-gray-600 mt-4">Soluciones específicas para necesidades concretas</p>
        </div>

        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {serviciosSueltos.map((servicio) => {
            const Icon = servicio.icon;
            const isHighlighted = servicio.highlight;

            return (
              <div
                key={servicio.slug}
                className={`group bg-white border rounded-3xl p-8 hover:shadow-xl transition-all ${isHighlighted ? 'border-amber-400 shadow-md' : 'border-gray-200 hover:border-green-500'}`}
              >
                {isHighlighted && (
                  <div className="inline-flex items-center gap-1.5 bg-amber-100 text-amber-700 text-xs font-bold px-4 py-1 rounded-full mb-5">
                    <CheckCircle size={18} /> Recomendado
                  </div>
                )}

                <div className="flex justify-center mb-6">
                  <div className={`w-20 h-20 rounded-2xl flex items-center justify-center ${isHighlighted ? 'bg-amber-50' : 'bg-green-50'}`}>
                    <Icon className={isHighlighted ? 'text-amber-600' : 'text-green-600'} size={42} />
                  </div>
                </div>

                <h3 className="text-2xl font-bold text-center mb-3">{servicio.title}</h3>
                <p className="text-4xl font-extrabold text-center mb-5 text-green-600">{servicio.price}</p>
                <p className="text-gray-600 text-center mb-8 min-h-[80px]">{servicio.tagline}</p>

                <Link
                  href={`/servicios/${servicio.slug}`}
                  onClick={() => analyticsEvents.trackEvent('cta_click', 'servicio', servicio.slug)}
                  className="block w-full text-center bg-gray-900 hover:bg-black text-white font-semibold py-4 rounded-2xl transition-all"
                >
                  Ver detalles →
                </Link>
              </div>
            );
          })}
        </div>
      </section>

      {/* CTA Final */}
      <div className="text-center mt-24 bg-gradient-to-br from-blue-700 to-blue-900 text-white rounded-3xl p-16">
        <h2 className="text-4xl font-bold mb-6">¿No sabes por dónde empezar?</h2>
        <p className="text-xl mb-10 max-w-2xl mx-auto">Agenda una llamada gratuita. Te ayudaremos a elegir la mejor combinación de servicios según tu caso.</p>
        <Link 
          href="/#asesoria" 
          onClick={() => analyticsEvents.trackEvent('cta_click', 'servicios', 'asesoria')}
          className="inline-flex items-center gap-3 bg-white text-blue-700 font-bold text-lg px-12 py-5 rounded-2xl hover:bg-gray-100 transition-all"
        >
          Solicitar asesoría personalizada
          <ArrowRight size={26} />
